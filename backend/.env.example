# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
POSTGRES_DB=madaflow
POSTGRES_USER=madaflow
POSTGRES_PASSWORD=madaflow_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# IA (clés jamais en dur dans le code — voir apps/ai_engine)
# rule_based : déterministe, sans coût, actif par défaut (suffisant pour le MVP).
# anthropic : nécessite ANTHROPIC_API_KEY, non testé en conditions réelles à ce stade — voir apps/ai_engine/providers/anthropic_provider.py.
AI_PROVIDER=rule_based
ANTHROPIC_API_KEY=
AI_DUPLICATE_AUTO_LINK_THRESHOLD=0.85

# Scoring de priorité (section 8) — seuils 0-100, ajustables sans redéploiement de code.
PRIORITY_LOW_MAX=25.0
PRIORITY_MEDIUM_MAX=50.0
PRIORITY_HIGH_MAX=75.0

# Paiement (Stripe ou équivalent — clés jamais en dur, section 20 du cahier des charges)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observabilité (production uniquement, voir config/settings/prod.py)
SENTRY_DSN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

