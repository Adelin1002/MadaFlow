# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
POSTGRES_DB=madaflow
POSTGRES_USER=madaflow
POSTGRES_PASSWORD=madaflow_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# IA (clés jamais en dur dans le code — voir apps/ai_engine)
AI_PROVIDER=stub
ANTHROPIC_API_KEY=

# Paiement (Stripe ou équivalent — clés jamais en dur, section 20 du cahier des charges)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
